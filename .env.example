# Copy to .env and enter keys locally. Never commit .env or paste keys in chat.
# KMA API Hub: register, request Numerical Weather Prediction API access.
# https://apihub.kma.go.kr/apiList.do?seqApi=9
KMA_API_KEY=

# Copernicus ADS: register, get personal access token, accept dataset terms.
# https://ads.atmosphere.copernicus.eu/how-to-api
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=

# ECMWF Data Store / TIGGE: same ECMWF account, separate service activation.
# https://ecds.ecmwf.int/how-to-api
ECDSAPI_URL=https://ecds.ecmwf.int/api
ECDSAPI_KEY=

# Public collectors do not load secrets. collect_tigge_sample.py explicitly reads
# only the ECDS endpoint/key from the local project .env. Do not overwrite ADS keys.
